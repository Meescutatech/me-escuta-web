# me-escuta-web — copie para .env.local (gitignored; NUNCA comite segredo)
#
# Dois alvos possíveis. Escolha UM:
#
# (A) REMOTO — projeto me_escuta_crm (ref rvvpfkdjburdorgegxop). É onde o W1 foi verificado:
#     PostgREST vivo, sem o problema de Rosetta. Pegue a chave anon com
#       supabase projects api-keys --project-ref rvvpfkdjburdorgegxop
#     e use:
#       NEXT_PUBLIC_SUPABASE_URL=https://rvvpfkdjburdorgegxop.supabase.co
#       NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon do comando acima>
#
#     Pré-requisito no projeto remoto: a Data API precisa EXPOR os schemas `core` e `api`
#     (`schemas = ["public", "api", "core", "graphql_public"]` no config.toml do me-escuta-db,
#     aplicado com `supabase config push`). Sem isso toda leitura volta
#     `PGRST106 Invalid schema: core`. `porta`/`ops`/`pgmq` seguem fora de propósito (RF-2).
#
# (B) LOCAL — stack do me-escuta-db (supabase start). A porta da API (kong) é a 54421
#     no config.toml do me-escuta-db (não a default 54321). Ver limitação Rosetta no README.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54421

# Chave publicável (anon) do stack local — vem de `supabase status` no me-escuta-db.
# É pública por design (RLS protege os dados); mesmo assim, fica só em .env.local, nunca no código.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH

# --- Só para o script de verificação e2e (scripts/verificacao-e2e.mjs), conexão direta ao Postgres ---
# Contorna o PostgREST (segfault Rosetta no Apple Silicon) para provar o fluxo via SQL.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54422/postgres
# Caminho do runtime (para o worker propor durante o e2e). Default: ../me-escuta-runtime
RUNTIME_DIR=../me-escuta-runtime

# Runtime de convites (Bloco C) — server-side only (server actions chamam com o JWT do gestor)
CONVITES_URL=http://localhost:8082
