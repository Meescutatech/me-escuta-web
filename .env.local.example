# me-escuta-web — copie para .env.local (gitignored; NUNCA comite segredo)
# Aponta para o STACK LOCAL do me-escuta-db (supabase start). A porta da API (kong) é a 54421
# no config.toml do me-escuta-db (não a default 54321).

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54421

# Chave publicável (anon) do stack local — vem de `supabase status` no me-escuta-db.
# É pública por design (RLS protege os dados); mesmo assim, fica só em .env.local, nunca no código.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH

# --- Só para o script de verificação e2e (scripts/verificacao-e2e.mjs), conexão direta ao Postgres ---
# Contorna o PostgREST (segfault Rosetta no Apple Silicon) para provar o fluxo via SQL.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54422/postgres
# Caminho do runtime (para o worker propor durante o e2e). Default: ../me-escuta-runtime
RUNTIME_DIR=../me-escuta-runtime
