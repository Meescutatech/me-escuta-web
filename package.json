    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "e2e": "node scripts/verificacao-e2e.mjs",
    "portao:f5": "node --experimental-strip-types scripts/portao-f5-tempo-real.mjs",
    "portao:f4": "node --experimental-strip-types --test tests/debounce-compartilhado.test.ts",
    "portao:f6": "node --experimental-strip-types scripts/portao-f6-readback.mjs",
    "portao:f21": "node --experimental-strip-types scripts/portao-f21-data-inbox.mjs",
    "bateria:f21": "node --experimental-strip-types scripts/bateria-f21.mjs",
    "bateria:enxerto": "node --experimental-strip-types scripts/bateria-enxerto-conferencia.mjs",
    "portao:f22": "node --experimental-strip-types scripts/portao-f22-paginacao.mjs",
    "bateria:f22": "node --experimental-strip-types scripts/bateria-f22.mjs"
