{
  "name": "me-escuta-web",
  "version": "0.1.0",
  "private": true,
  "description": "UI do sistema Me Escuta — W1: auth + timeline crua do ledger + fila HITL (aprovar/rejeitar via RPC-porta). Sprint 1/F1 (RF-7).",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
